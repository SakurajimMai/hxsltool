{
  "name": "@hxsl/web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0 --port ${APP_PORT:-13080}",
    "prebuild": "pnpm --filter @hxsl/processing-shared build && pnpm --filter @hxsl/tool-registry build",
    "pretest": "pnpm --filter @hxsl/processing-shared build && pnpm --filter @hxsl/tool-registry build",
    "build": "next build",
    "start": "HOSTNAME=0.0.0.0 PORT=${APP_PORT:-13080} node .next/standalone/apps/web/server.js",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "node ../../scripts/e2e-smoke.mjs"
  },
  "dependencies": {
    "@hxsl/processing-shared": "workspace:*",
    "@hxsl/tool-registry": "workspace:*",
    "jszip": "3.10.1",
    "lucide-react": "0.468.0",
    "next": "15.5.6",
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "qrcode": "1.5.4",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sharp": "0.34.3"
  },
  "devDependencies": {
    "@types/jszip": "^3.4.1",
    "@types/node": "22.10.2",
    "@types/qrcode": "1.5.5",
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.2"
  }
}
