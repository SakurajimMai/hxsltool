SITE_NAME=HXSL Tools
# Absolute public origin for this deployment, including https:// and no trailing slash.
# A bare host is accepted and treated as https. Do not use ${...} placeholders that Zeabur did not expand.
# On Zeabur, prefer the bound custom origin, or the expanded ${ZEABUR_WEB_URL} value.
SITE_URL=
DEFAULT_LOCALE=en
APP_HOST=0.0.0.0
APP_PORT=13080
ALLOW_INDEXING=true
ENABLE_SERVER_TOOLS=true
ENABLE_ANALYTICS=false
ENABLE_ADS=false
GOOGLE_ADSENSE_CLIENT=
GOOGLE_ADSENSE_SLOT=
GOOGLE_ADSENSE_AUTO_ADS=true
MAX_FILES_PER_BATCH=100
MAX_IMAGE_MB=8
MAX_PDF_MB=50
MAX_OUTPUT_BYTES=209715200
MAX_DECODED_PIXELS=40000000
MAX_PDF_PAGES=300
MAX_JOB_SECONDS=120
MAX_ACTIVE_JOBS=4
JOB_RATE_LIMIT_PER_MINUTE=30
RESULT_TTL_SECONDS=900
HXSL_JOB_DIR=/var/lib/hxsl
JOB_TOKEN_SECRET=
# true when TLS is terminated in front of the process (Zeabur, Caddy, Nginx).
TRUSTED_PROXY=false
# Operator contact for the contact page. Empty shows the missing-email callout.
CONTACT_EMAIL=
